# 敏感凭据（.env 含真实 SIF/飞书凭据）
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# Python 虚拟环境（体积大，不入库）
.venv/
venv/
env/

# Sif 本地缓存（cookie / token，等于长效凭据）
.sif_cookie_cache
.sif_token_cache

# 同步断点续传
sif_sync_checkpoint.json

# 监控结果表 spreadsheet_token 缓存（运行期生成，含表格 token，不入库）
.feishu_report_state.json

# Claude Code 工作目录（含本地计划/记忆）
.claude/

# AI agent 工具 skill 配置（openspec/opsx，工具生成，不入仓库）
.agents/

# 项目内 todo / 经验记录（开发过程产物，不入仓库）
todo.md
lessons.md

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# 数据导出（CSV / XLSX，分析产物，不入仓库）
